local function createToggle(yOff, labelText, defaultVal, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -18, 0, 36)
    row.Position = UDim2.new(0, 9, 0, yOff)
    row.BackgroundTransparency = 1
    row.ZIndex = 2
    row.Parent = settingsPanel

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.62, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(195, 195, 215)
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 3
    lbl.Parent = row

    local pill = Instance.new("TextButton")
    pill.Size = UDim2.new(0, 54, 0, 24)
    pill.Position = UDim2.new(1, -62, 0.5, -12)
    pill.BackgroundColor3 = defaultVal
        and Color3.fromRGB(48, 190, 95)
        or  Color3.fromRGB(75, 75, 98)
    pill.Font = Enum.Font.GothamBold
    pill.Text = defaultVal and "ON" or "OFF"
    pill.TextColor3 = Color3.new(1,1,1)
    pill.TextSize = 11
    pill.ZIndex = 3
    pill.Parent = row
    applyCorner(pill, 12)

    local val = defaultVal
    pill.MouseButton1Click:Connect(function()
        val = not val
        tw(pill, {BackgroundColor3 = val
            and Color3.fromRGB(48, 190, 95)
            or  Color3.fromRGB(75, 75, 98)}, 0.15)
        pill.Text = val and "ON" or "OFF"
        callback(val)
    end)
    pill.MouseEnter:Connect(function() tw(pill, {BackgroundTransparency = 0.15}, 0.1) end)
    pill.MouseLeave:Connect(function() tw(pill, {BackgroundTransparency = 0},    0.1) end)
end

-- ────────────────────────────────────────────────────────────────
--  AUTO-RESIZE  (height from left column; width from settings toggle)
-- ────────────────────────────────────────────────────────────────
local function updateLayout(animate)
    -- Left column sizes
    local clockH = showDate and 102 or 80
    clockSection.Size = UDim2.new(0, LEFT_W, 0, clockH)
    dateTxt.Visible   = showDate

    local swY = CONTENT_Y + clockH + 8
    swFrame.Position = UDim2.new(0, LEFT_X, 0, swY)
    swFrame.Size     = UDim2.new(0, LEFT_W, 0, 244)
    swFrame.Visible  = showStopwatch

    -- Total height driven by left column
    local leftH = clockH + (showStopwatch and (8 + 244) or 0)
    local totalH = compactMode and TITLE_H or (CONTENT_Y + leftH + BOT_PAD)

    -- Right panel height matches left content area
    settingsPanel.Size = UDim2.new(0, RIGHT_W, 0, leftH)

    -- Width: slim if settings hidden, full if open
    local totalW = (not compactMode and settingsOpen) and FULL_W or SLIM_W

    divider.Visible = settingsOpen and not compactMode
    divider.Size    = UDim2.new(0, 1, 0, leftH)
    divider.Position = UDim2.new(0, RIGHT_X - 8, 0, CONTENT_Y)

    if animate then
        tw(main,   {Size = UDim2.new(0, totalW, 0, totalH)}, 0.28, Enum.EasingStyle.Quint)
        tw(shadow, {Size = UDim2.new(0, totalW + 14, 0, totalH + 12)}, 0.28, Enum.EasingStyle.Quint)
    else
        main.Size   = UDim2.new(0, totalW, 0, totalH)
        shadow.Size = UDim2.new(0, totalW + 14, 0, totalH + 12)
    end

    -- Position main centered
    main.Position = UDim2.new(0.5, -totalW / 2, 0.5, -totalH / 2)

    local mp = main.Position
    shadow.Position = UDim2.new(mp.X.Scale, mp.X.Offset - 8, mp.Y.Scale, mp.Y.Offset + 9)
end

