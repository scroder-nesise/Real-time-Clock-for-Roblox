-- ────────────────────────────────────────────────────────────────
--  AUTO-RESIZE LOGIC
-- ────────────────────────────────────────────────────────────────
local function updateMainSize()
    local baseHeight = 44           -- title bar
               + 10                 -- top padding
               + 90                 -- clock
               + 10                 -- gap after clock

    local contentHeight = baseHeight

    if showStopwatch then
        contentHeight += 220 + 12     -- stopwatch frame + bottom padding
    end

    if settingsPanel.Visible then
        contentHeight += 110 + 12     -- settings panel + padding
    else
        -- when settings hidden, we still need space at bottom
        contentHeight += 20
    end

    main.Size = UDim2.new(0, 320, 0, contentHeight)

    -- Keep settings panel anchored to bottom when visible
    if settingsPanel.Visible then
        settingsPanel.Position = UDim2.new(0,12,1,-122)   -- - (110 + 12 padding)
    end
end

-- Toggle settings panel + resize
settingsBtn.MouseButton1Click:Connect(function()
    settingsPanel.Visible = not settingsPanel.Visible
    settingsBtn.ImageColor3 = settingsPanel.Visible 
        and Color3.fromRGB(100,200,255) 
        or  Color3.fromRGB(160,160,180)
    updateMainSize()
end)

-- Initial setup
updateMainSize()

-- ────────────────────────────────────────────────────────────────
--  LOGIC (stopwatch + clock)
-- ────────────────────────────────────────────────────────────────
local isRunning, swTimeSec, startClock = false, 0, 0

local function fmtClock()
    return os.date(use24h and "%H:%M:%S" or "%I:%M:%S %p")
end

local function fmtStopwatch()
    local t = swTimeSec
    if isRunning then t = t + (os.clock() - startClock) end
    local m = math.floor(t / 60)
    local s = math.floor(t % 60)
    local c = math.floor((t % 1) * 100)
    return string.format("%02d:%02d.%02d", m, s, c)
end

local function updateBtns()
    if isRunning then
        startPauseBtn.Text = "PAUSE"
        startPauseBtn.BackgroundColor3 = Color3.fromRGB(220, 140, 0)
    else
        startPauseBtn.Text = (swTimeSec > 0) and "RESUME" or "START"
        startPauseBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    end
end

startPauseBtn.MouseButton1Click:Connect(function()
    if isRunning then
        swTimeSec += (os.clock() - startClock)
        isRunning = false
    else
        startClock = os.clock()
        isRunning = true
    end
    updateBtns()
end)

resetBtn.MouseButton1Click:Connect(function()
    isRunning = false
    swTimeSec = 0
    for _,c in ipairs(lapList:GetChildren()) do
        if c:IsA("GuiObject") then c:Destroy() end
    end
    updateBtns()
end)

lapBtn.MouseButton1Click:Connect(function()
    if not isRunning then return end
    local t = swTimeSec + (os.clock() - startClock)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,0,28)
    lbl.BackgroundColor3 = Color3.fromRGB(34,34,42)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = string.format("Lap %d  %s", #lapList:GetChildren(), fmtStopwatch())
    lbl.TextColor3 = Color3.fromRGB(220,220,240)
    lbl.TextSize = 15
    lbl.Parent = lapList

    local lc = Instance.new("UICorner")
    lc.CornerRadius = UDim.new(0,6)
    lc.Parent = lbl
end)

-- Hover feedback
local function hoverEffect(btn, baseColor)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.14), {BackgroundColor3 = baseColor:Lerp(Color3.new(1,1,1),0.15)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.14), {BackgroundColor3 = baseColor}):Play()
    end)
end

hoverEffect(startPauseBtn, Color3.fromRGB(40,180,40))
hoverEffect(resetBtn,     Color3.fromRGB(180,40,40))
hoverEffect(lapBtn,       Color3.fromRGB(50,130,255))

