RunService.Heartbeat:Connect(function()
    if not compactMode then
        clockTxt.Text = fmtClock()
        if showDate      then dateTxt.Text = fmtDate() end
        if showStopwatch then swTime.Text  = fmtSW()   end
    end
end)

