local swStart    = 0

local function fmtClock()
    return os.date(use24h and "%H:%M:%S" or "%I:%M:%S %p")
end

local function fmtDate()
    return os.date("%a, %d %b %Y")
end

local function fmtSW()
    local t = swTimeSec
    if isRunning then t = t + (os.clock() - swStart) end
    local m  = math.floor(t / 60)
    local s  = math.floor(t % 60)
    local cs = math.floor((t % 1) * 100)
    return showMs
        and string.format("%02d:%02d.%02d", m, s, cs)
        or  string.format("%02d:%02d", m, s)
end

local function refreshBtns()
    local col, lbl
    if isRunning then
        col, lbl = Color3.fromRGB(220,140,0), "PAUSE"
    elseif swTimeSec > 0 then
        col, lbl = Color3.fromRGB(35,175,80),  "RESUME"
    else
        col, lbl = Color3.fromRGB(35,175,80),  "START"
    end
    tw(startPauseBtn, {BackgroundColor3 = col}, 0.15)
    startPauseBtn.Text = lbl
end

startPauseBtn.MouseButton1Click:Connect(function()
    if isRunning then
        swTimeSec += (os.clock() - swStart)
        isRunning = false
    else
        swStart   = os.clock()
        isRunning = true
    end
    refreshBtns()
end)

resetBtn.MouseButton1Click:Connect(function()
    isRunning = false
    swTimeSec = 0
    lapCount  = 0
    for _, c in ipairs(lapList:GetChildren()) do
        if c:IsA("GuiObject") then c:Destroy() end
    end
    refreshBtns()
    swTime.Text = showMs and "00:00.00" or "00:00"
end)

lapBtn.MouseButton1Click:Connect(function()
    if not isRunning then return end
    lapCount += 1
    local t = fmtSW()

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 24)
    row.BackgroundColor3 = lapCount % 2 == 0
        and Color3.fromRGB(26, 26, 36)
        or  Color3.fromRGB(20, 20, 28)
    row.BorderSizePixel = 0
    row.ZIndex = 3
    row.Parent = lapList
    applyCorner(row, 5)

    local n = Instance.new("TextLabel")
    n.Size = UDim2.new(0.38, 0, 1, 0)
    n.Position = UDim2.new(0, 6, 0, 0)
    n.BackgroundTransparency = 1
    n.Font = Enum.Font.GothamBold
    n.Text = "Lap " .. lapCount
    n.TextColor3 = themes[currentTheme].accent
    n.TextSize = 12
    n.TextXAlignment = Enum.TextXAlignment.Left
    n.ZIndex = 4
    n.Parent = row

    local ts = Instance.new("TextLabel")
    ts.Size = UDim2.new(0.60, 0, 1, 0)
    ts.Position = UDim2.new(0.40, 0, 0, 0)
    ts.BackgroundTransparency = 1
    ts.Font = Enum.Font.RobotoMono
    ts.Text = t
    ts.TextColor3 = Color3.fromRGB(205, 205, 225)
    ts.TextSize = 12
    ts.TextXAlignment = Enum.TextXAlignment.Right
    ts.ZIndex = 4
    ts.Parent = row

    task.defer(function()
        lapList.CanvasPosition = Vector2.new(0, lapList.AbsoluteCanvasSize.Y)
    end)
end)

local function hoverSW(btn, base)
    btn.MouseEnter:Connect(function() tw(btn, {BackgroundColor3 = base:Lerp(Color3.new(1,1,1),0.18)}, 0.12) end)
    btn.MouseLeave:Connect(function() tw(btn, {BackgroundColor3 = base}, 0.12) end)
end
hoverSW(resetBtn, Color3.fromRGB(190, 45, 45))
hoverSW(lapBtn,   Color3.fromRGB(50, 120, 240))

